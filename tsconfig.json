{
"compilerOptions": {
"target": "ES2022",
"module": "ESNext",
"moduleResolution": "node",
"ignoreDeprecations": "6.0",
"outDir": "./dist",
"rootDir": "./",
"strict": false,
"esModuleInterop": true,
"skipLibCheck": true,
"allowJs": true,
"resolveJsonModule": true
},
"exclude": ["dist", "node_modules", "auth"]
}
